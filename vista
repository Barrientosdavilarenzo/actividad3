   private void valIniciales(){
       this.panelIngreso.setVisible(true);
       this.panelOperaciones.setVisible(true);
       this.panelResultado.setVisible(false);
       this.btnCalcular.setEnabled(false);
       this.btnNuevo.setEnabled(false);
       this.btnSalir.setEnabled(true);
   }
   
     public double getLado() {
        try {
            return Double.parseDouble(txtLado.getText());
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(this, "Por favor, ingrese un número válido para el lado.", "Error", JOptionPane.ERROR_MESSAGE);
            return 0; 
        }
    }

    public void mostrarResultado(double area, double perimetro) {
        txtResultadoArea.setText(String.format("%.2f", area));
        txtResultadoPerimetro.setText(String.format("%.2f", perimetro));
    }
    public void agregarActionListener(ActionListener listener) {
        btnCalcular.addActionListener(listener);
    }
