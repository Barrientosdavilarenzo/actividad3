    private void btnCalcularActionPerformed(java.awt.event.ActionEvent evt) {                                            
        
        float lado;
        
        if (txtLado.getText().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Ingrese un valor");
        } else {
            lado = Float.parseFloat(txtLado.getText().trim());
            cua.setLado(lado);
            cua.hallarArea();
            this.txtResultadoArea.setText(String.valueOf(cua.mostrarArea()));
            this.setSize(new Dimension(370, 300));
            this.panelResultado.setVisible(true);
            this.btnNuevo.setEnabled(true);
            this.panelResultado.setBackground(new Color(255, 255, 255));
        }
        this.txtLado.requestFocus();
        this.btnCalcular.setEnabled(false);
    }                                           

    private void btnNuevoActionPerformed(java.awt.event.ActionEvent evt) {                                         
        
        this.txtLado.setText("");
        this.txtResultadoArea.setText("");
        this.setSize(new Dimension(370, 170));
        this.panelResultado.setVisible(false);
        this.txtLado.requestFocus();
        this.btnNuevo.setEnabled(false);
        this.btnCalcular.setEnabled(false);
    }                                        

    private void formWindowActivated(java.awt.event.WindowEvent evt) {                                     
        
        valIniciales();
    }                                    

    private void txtLadoActionPerformed(java.awt.event.ActionEvent evt) {                                        
        
        this.btnCalcular.doClick();
        this.txtLado.setText("");
        this.txtLado.requestFocus();
        this.btnCalcular.setEnabled(false);
        this.btnNuevo.setEnabled(true);
    }                                       

    private void txtLadoKeyTyped(java.awt.event.KeyEvent evt) {                                 
        
        this.btnCalcular.setEnabled(true);
        char c = evt.getKeyChar();
        if (!Character.isDigit(c)) {
            evt.consume();
        }
    }                                

    private void txtLadoKeyPressed(java.awt.event.KeyEvent evt) {                                   
        
        if (evt.getKeyCode() == KeyEvent.VK_ENTER) {
            btnCalcular.doClick();
        }
    }                                  

    private void btnSalirActionPerformed(java.awt.event.ActionEvent evt) {                                         
        int r = JOptionPane.showOptionDialog(this, "Estas seguro de Salir ...?",
                "Area Cuadrado", JOptionPane.YES_NO_OPTION, JOptionPane.QUESTION_MESSAGE,
                null, new Object[] {"Si salgo", "No Salgo"}, "No Salgo");
        if (r == 0) {
            System.exit(0);
        } 
        this.txtLado.requestFocus();
    
    }                                        

